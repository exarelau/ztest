REPORT yrp_test_001.

DATA: ls_header_data    TYPE bapiobdlvhdrchg,
      ls_header_control TYPE bapiobdlvhdrctrlchg,
      ls_extension2     TYPE bapiext,
      lt_extension2     TYPE TABLE OF bapiext,
      lt_return         TYPE TABLE OF bapiret2.

" 1. Setup Header
ls_header_data-deliv_numb    = '0100172532'.
ls_header_control-deliv_numb = '0100172532'.

" 2. Setup Extension2
ls_extension2-param = 'VBKOK'.        " Identify header structure
ls_extension2-field = 'ZZ_MRN_NO'.    " Field name in LIKP
ls_extension2-value = '1'.
APPEND ls_extension2 TO lt_extension2.

" 3. Call BAPI
CALL FUNCTION 'BAPI_OUTB_DELIVERY_CHANGE'
  EXPORTING
    header_data    = ls_header_data
    header_control = ls_header_control
    delivery       = '0100172532'
  TABLES
    extension2     = lt_extension2
    return         = lt_return.

" 4. Commit Changes
READ TABLE lt_return WITH KEY type = 'E' TRANSPORTING NO FIELDS.
IF sy-subrc <> 0.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = 'X'.
ELSE.
  ROLLBACK WORK.
ENDIF.




